<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:background="@color/white"
        android:layout_height="wrap_content"
        android:id="@+id/rowLayoutId"
        android:padding="24sp">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/numId"
            android:layout_width="wrap_content"
            android:text="1"
            android:textColor="@color/black"
            app:layout_constraintBottom_toBottomOf="parent"
            android:textSize="40sp"
            android:padding="2sp"
            android:maxLength="3"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_height="wrap_content" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/firstNameId"
            app:layout_constraintStart_toEndOf="@+id/numId"
            android:layout_width="wrap_content"
            android:text="John"
            android:textColor="@color/black"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="5dp"
            android:textSize="40sp"
            android:maxLength="6"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_height="wrap_content" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/lastNameId"
            android:layout_width="wrap_content"
            android:text="Doe"
            android:textColor="@color/black"
            android:maxLines="1"
            android:maxLength="6"
            app:layout_constraintBottom_toBottomOf="parent"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@+id/firstNameId"
            android:layout_marginStart="5dp"
            android:textSize="40sp"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_height="wrap_content" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/ageId"
            android:layout_width="wrap_content"
            android:text="( 1 )"
            android:textColor="@color/black"
            app:layout_constraintStart_toEndOf="@+id/lastNameId"
            android:layout_marginStart="5dp"
            android:textSize="20sp"
            android:maxLength="3"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_height="wrap_content" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>